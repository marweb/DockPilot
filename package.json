{
  "name": "dockpilot",
  "version": "2.0.8",
  "description": "Web-based Docker administration GUI - Self-hosted alternative to Docker Desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:dev": "docker compose -f infra/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f infra/docker-compose.yml up --build -d"
  },
  "keywords": [
    "docker",
    "gui",
    "web",
    "administration",
    "containers",
    "devops"
  ],
  "author": "DockPilot Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "better-sqlite3", "esbuild", "protobufjs"],
    "overrides": {
      "flatted": ">=3.3.3",
      "picomatch": ">=4.0.4",
      "fast-uri": ">=3.1.0",
      "form-data": ">=4.0.4",
      "bn.js": ">=5.2.3",
      "ajv": ">=8.18.0",
      "yaml": ">=2.8.2",
      "@babel/helpers": ">=7.29.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.4",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
